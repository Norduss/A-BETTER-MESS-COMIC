---
import SiteLayout from '../layouts/SiteLayout.astro';
import ChapterReader from '../components/reader/ChapterReader.astro';
import { chapters } from '../content/chapters';
import '../styles/story.css';
---

<SiteLayout title="Inicio" immersive>
  <section class="shell cover" aria-labelledby="portada">
    <div>
      <h1 id="portada" class="cover-title">A Better Mess</h1>
      <p class="intro">Entre chapas, puentes y tuberías, Los Desparchados han hecho hogar con lo que otros tiraron. Blund solo quiere pasar el día tranquilo.</p>
      <a class="action" href="#relato">Desplázate para leer <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <div id="relato" class="story" tabindex="-1" aria-label="Lectura completa">
    <nav class="story-nav" aria-label="Capítulos del relato">
      <span>Capítulos</span>
      <ol>
        {chapters.map((chapter) => (
          <li><a href={`#${chapter.id}`} aria-label={`Capítulo ${chapter.number}. ${chapter.title}`} title={chapter.title}>{chapter.number}</a></li>
        ))}
      </ol>
    </nav>
    {chapters.map((chapter, index) => <ChapterReader chapter={chapter} embedded eager={index === 0} />)}
    <footer class="reader-end shell">
      <p>Fin de los capítulos disponibles</p>
      <a class="reader-back" href="#portada">Volver al comienzo</a>
    </footer>
  </div>
</SiteLayout>

<script>
  import { setupStoryMotion } from '../effects/story-motion';
  setupStoryMotion();
</script>
