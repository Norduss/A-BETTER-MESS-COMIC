---
import '../styles/site.css';

interface Props {
  title: string;
  immersive?: boolean;
}

const { title, immersive } = Astro.props;
const atHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A Better Mess, un cómic digital sobre un mundo construido con lo que otros desecharon." />
    <meta name="theme-color" content="#0f0d0b" />
    <title>{title} · A Better Mess</title>
    <link rel="preload" href="/fonts/big-shoulders-stencil-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={[{ immersive }]}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/">A BETTER MESS</a>
        <nav aria-label="Principal">
          <a href="/" aria-current={atHome ? 'page' : undefined}>Inicio</a>
          <a href="/capitulos/" aria-current={Astro.url.pathname === '/capitulos/' ? 'page' : undefined}>Capítulos</a>
        </nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer id="creditos" class="site-footer">
      <div class="shell footer-content">
        <div class="footer-main">
          <div class="footer-about">
            <a class="footer-brand" href="/">A Better Mess</a>
            <p>Cómic de lectura vertical continua</p>
          </div>
          <a class="footer-wiki" href="https://a-better-mess-wiki.vercel.app/">
            Ir a la wiki
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
        <section class="footer-team" aria-labelledby="equipo">
          <h2 id="equipo">Equipo</h2>
          <dl>
            <div>
              <dt>Historia y creación</dt>
              <dd>Steven Camilo Franco Bocanegra</dd>
            </div>
            <div>
              <dt>Cómic</dt>
              <dd><span>Steven Camilo Franco Bocanegra</span><span>Juan Andrés Escobar Castillo</span></dd>
            </div>
            <div>
              <dt>Wiki</dt>
              <dd><span>Santiago Peña Agudelo</span><span>Alejandro Arias Ramírez</span></dd>
            </div>
          </dl>
        </section>
        <p class="footer-note">Diseño Transmedia · Prototipo 2026</p>
      </div>
    </footer>
  </body>
</html>
