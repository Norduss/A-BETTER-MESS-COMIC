---
import type { Chapter } from '../../content/types';
import { themeFor } from '../../content/chapter-themes';
import PanelView from './PanelView.astro';
import ChapterIntro from './ChapterIntro.astro';
import '../../styles/reader.css';

interface Props {
  chapter: Chapter;
  embedded?: boolean;
  eager?: boolean;
}

const { chapter, embedded, eager = true } = Astro.props;
const panels = chapter.rows.flat();
const theme = themeFor(chapter.id);
const Heading = embedded ? 'h2' : 'h1';
const titleId = embedded ? `${chapter.id}-title` : 'chapter-title';
const anchorFor = (id: string) => (embedded ? `${chapter.id}-${id}` : id);
---

<article
  id={embedded ? chapter.id : undefined}
  class:list={['chapter', `chapter--${theme.style}`]}
  data-chapter={chapter.id}
  style={`--chapter-bg: ${theme.bg}; --accent: ${theme.accent}`}
  tabindex={embedded ? -1 : undefined}
  aria-labelledby={titleId}
>
  <ChapterIntro chapter={chapter} heading={Heading} titleId={titleId} firstPanelHref={panels[0] ? `#${anchorFor(panels[0].id)}` : undefined} />

  <div class:list={['reader-stage', 'shell', { 'reader-stage--indexed': !embedded }]}>
    {!embedded && (
      <nav class="scene-nav" aria-label="Viñetas del capítulo">
        <ul>
          {panels.map((panel) => (
            <li><a href={`#${panel.id}`} aria-label={`${panel.id}, ${panel.label}`}>{panel.id}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="panel-sequence">
      {chapter.rows.map((row, rowIndex) => (
        <div class:list={['panel-row', { 'panel-row--shared': row.length > 1 }]} style={`--columns: ${row.length}`}>
          {row.map((panel, panelIndex) => (
            <PanelView
              panel={panel}
              anchorId={anchorFor(panel.id)}
              eager={eager && rowIndex === 0 && panelIndex === 0}
              order={panelIndex}
            />
          ))}
        </div>
      ))}
    </div>
  </div>

  {!embedded && <footer class="reader-end shell">
    <p>Fin del capítulo {chapter.number}</p>
    <div class="reader-end-links">
      <a class="reader-back" href={`#${titleId}`}>Volver al comienzo</a>
      <a class="reader-back" href={`/#${chapter.id}`}>Leer en la historia completa</a>
      <a class="reader-back" href="/capitulos/">Volver a capítulos</a>
    </div>
  </footer>}
</article>
